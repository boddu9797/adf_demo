{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "demo-adf-bbk"
		},
		"LS_SQLSERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLSERVER'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demobharathadls.dfs.core.windows.net/"
		},
		"LS_SQLSERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "demo-bbk.database.windows.net"
		},
		"LS_SQLSERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "demo_sql_db"
		},
		"LS_SQLSERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "boddu9797"
		},
		"tgr_event_simple_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/6d3dd380-bc79-4bc6-b731-b6c621058cbb/resourceGroups/BharathRG/providers/Microsoft.Storage/storageAccounts/demobharathadls"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "demo-adf-bbk_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQLSERVER_password": {
						"value": "[parameters('LS_SQLSERVER_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_SQLSERVER_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLSERVER_properties_typeProperties_server')]"
					},
					"LS_SQLSERVER_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLSERVER_properties_typeProperties_database')]"
					},
					"LS_SQLSERVER_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLSERVER_properties_typeProperties_userName')]"
					},
					"tgr_event_simple_properties_typeProperties_scope": {
						"value": "[parameters('tgr_event_simple_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}